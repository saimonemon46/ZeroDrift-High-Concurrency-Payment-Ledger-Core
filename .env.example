# LedgerCore Environment Configuration

# Application
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_USER=ledger_admin
POSTGRES_PASSWORD=ledger_secret
POSTGRES_DB=ledger_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ledger_admin:ledger_secret@localhost:5432/ledger_db

# Redis Cache & Idempotency Store
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
